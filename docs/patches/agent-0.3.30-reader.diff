+// 0.3.30: dump the candidate 3D list-head table regions ONCE at battle start (envelope). Offline analysis
+// finds which words are real list-head pointers → pins the true Steam list-head offset + stride, so a wrong
+// walk above costs only a (bounded, safe) miss. Format: for each candidate [u32 blk_off][u16 len][len bytes].
+unsafe fn dump_3d_heads(h: &mem::Proc, blk: usize) -> Vec<u8> {
+    let mut b = Vec::new();
+    for &hb in CALIB3D_HEAD_CANDS.iter() {
+        let region = read_at(h, blk + hb, CALIB3D_HEAD_DUMP).unwrap_or_default();
+        b.extend_from_slice(&(hb as u32).to_le_bytes());
+        b.extend_from_slice(&(region.len() as u16).to_le_bytes());
+        b.extend_from_slice(&region);
+    }
+    b
+}
