+// 0.3.30: walk the 3D / NaomiLib render machine's effect lists (5..=13) and capture each drawn 3D-class
+// node's RAW 448-B prefix (self-describing — see the CALIB3D_* block). This is the render machine
+// `harvest_objs` cannot reach: the 2D slot table (blk+0x2f4d0) holds none of these (0.3.29 confirmed 0
+// cat 5-13). Read-only RPM; every read of a GUESSED pointer fails safe (`read_at` → None). Bounded HARD:
+// ≤2 candidate head tables × 9 lists × CALIB3D_MAX_HOPS, capped at CALIB3D_MAX_NODES prefixes per call.
+unsafe fn harvest_3d(h: &mem::Proc, blk: usize, out: &mut Vec<Vec<u8>>) {
+    let u64_at = |a: usize| read_at(h, a, 8).filter(|b| b.len() >= 8)
+        .map(|b| u64::from_le_bytes([b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7]]) as usize);
+    let sane = |p: usize| p > 0x10000 && p < 0x7fff_ffff_ffff;
+    let rd_u64 = |buf: &[u8], o: usize| -> usize {
+        u64::from_le_bytes([buf[o], buf[o+1], buf[o+2], buf[o+3], buf[o+4], buf[o+5], buf[o+6], buf[o+7]]) as usize };
+    let mut seen: Vec<usize> = Vec::new();                          // per-call cycle / dedup guard (bounded)
+    'cands: for &hb in CALIB3D_HEAD_CANDS.iter() {
+        for idx in CALIB3D_LIST_LO..=CALIB3D_LIST_HI {
+            let head = match u64_at(blk + hb + idx * CALIB3D_HEAD_STRIDE) { Some(p) if sane(p) => p, _ => continue };
+            let mut node = head;
+            let mut hops = 0usize;
+            while sane(node) && hops < CALIB3D_MAX_HOPS {
+                hops += 1;
+                if seen.contains(&node) { break; }                 // cycle / already walked this node
+                seen.push(node);
+                let buf = match read_at(h, node, CALIB3D_PREFIX_LEN).filter(|b| b.len() >= CALIB3D_PREFIX_LEN) { Some(b) => b, None => break };
+                let cat = buf[H_CATEGORY] as usize;
+                // 3D-node structural gate (finding:3d_draw_emit_map): a drawn node has a model/POL pointer set.
+                // Check BOTH the DC slot (+0x84) and its +0x44-shifted Steam candidate (+0xC8), since the node
+                // layout's Steam delta is unconfirmed — the raw prefix pins it offline regardless.
+                let model_ok = sane(rd_u64(&buf, 0x84)) || sane(rd_u64(&buf, 0xc8));
+                if cat >= CALIB3D_LIST_LO && cat <= CALIB3D_LIST_HI && model_ok {
+                    out.push(buf[..CALIB3D_PREFIX_LEN].to_vec());
+                    if out.len() >= CALIB3D_MAX_NODES { break 'cands; }
+                }
+                node = u64_at(node + CALIB3D_NODE_NEXT).unwrap_or(0);
+            }
+        }
+    }
+}
