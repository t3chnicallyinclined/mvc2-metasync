 const PICKS_OFF:       usize = 0x758;       // char-select LOCKED picks (stride-4 char_ids) at game_state+this
+// ── character-select detection, read from the MATCH BLOCK (2026-08-26) ──────────────────────────
+// Supersedes menu scripting / screen scraping for OBSERVING which screen we are on and who is
+// selected. PICKS_OFF above gives OUR OWN locked team only; these give BOTH teams.
+const MODE_OFF:        usize = 0x3cb8;      // blk+0x3CB8 byte[2]: 1 = CHARACTER SELECT, 2 = IN BATTLE
+const H0_OFF:          usize = 0x3db8;      // blk+0x3DB8 = fighter slot 0 (⚠ NOT MATCH_ARR_ADD 0x3f24,
+                                            //   which is 0x16C INSIDE the object — see rr-steam-object-base-fix)
+const H_STRIDE:        usize = 0x738;
+const H_CID:           usize = 0x6c0;       // slot CID — ALSO where the char-select cursor writes
@@
     picks   // NO -1 requirement (a fully-locked team has no in-team -1). The CALLER gates on scene==5 && no live
             // fighters (= char-select), so a settled menu/in-fight state never surfaces a stale team here.
