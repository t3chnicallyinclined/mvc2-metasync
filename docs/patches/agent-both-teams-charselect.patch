+
+/// Which screen the SIMULATION is on: 1 = character select, 2 = in battle, 0 = unknown.
+/// Cheaper and more direct than inferring from `scene` + live-fighter heuristics.
+unsafe fn read_sim_mode(h: &mem::Proc, exe_base: usize) -> u8 {
+    match pointer_follow_blk(h, exe_base) {
+        Some(blk) => read_at(h, blk + MODE_OFF, 5).map(|b| b[2]).unwrap_or(0),
+        None => 0,
+    }
+}
+
+/// BOTH teams, read locally from the match block: `[p1a,p1b,p1c, p2a,p2b,p2c]`.
+///
+/// The character-select cursor writes its selection into the fighter slot's CID field, so this is
+/// live during selection and settled once the mode flips to 2. Slots interleave EVEN = P1 team,
+/// ODD = P2 team. Returns empty if the block is unreadable or any slot holds a non-character id.
+///
+/// ⚠ LIVE, not final, while a player is still hovering — gate on `read_sim_mode() == 2`, or on the
+/// values holding steady, before treating it as the locked team.
+unsafe fn read_both_teams(h: &mem::Proc, exe_base: usize) -> Vec<u8> {
+    let blk = match pointer_follow_blk(h, exe_base) { Some(b) => b, None => return Vec::new() };
+    let mut p1 = Vec::new();
+    let mut p2 = Vec::new();
+    for i in 0..6usize {
+        let cid = match read_at(h, blk + H0_OFF + i * H_STRIDE + H_CID, 1) {
+            Some(b) if !b.is_empty() => b[0],
+            _ => return Vec::new(),
+        };
+        if cid > 0x3A { return Vec::new(); }            // not a character id → block not populated yet
+        if i % 2 == 0 { p1.push(cid) } else { p2.push(cid) }
+    }
+    p1.extend(p2);
+    p1
+}
